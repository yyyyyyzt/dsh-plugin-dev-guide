{
  "name": "wsgw-solution-review",
  "version": "0.1.0-dev.0",
  "description": "DSH plugin: AI pre-review of wsgw technical solutions (suggest-only, expert-confirmed, memory-backed).",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "solution-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyyyyyzt/dsh-plugin-dev-guide.git",
    "directory": "plugins/wsgw-solution-review"
  },
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./persona": {
      "types": "./lib/types/persona.d.ts",
      "default": "./lib/persona.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "rules",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run tests/engine",
    "bench": "BENCH=1 vitest run tests/bench",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && tsdown",
    "prepare": "pnpm run build",
    "dsh:install": "pnpm install && pnpm run build && npx -y @deepseek-ai/dsh plugin --profile web add .",
    "dsh:verify": "npx -y @deepseek-ai/dsh --profile web --dump-config",
    "check:bundle": "node tests/client/check-bundle.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
