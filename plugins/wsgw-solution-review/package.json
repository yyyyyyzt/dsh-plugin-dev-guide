{
  "name": "wsgw-solution-review",
  "version": "0.1.0-dev.0",
  "description": "DSH plugin: AI pre-review of wsgw technical solutions (suggest-only, expert-confirmed, memory-backed).",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./tools": { "types": "./lib/types/tools.d.ts", "default": "./lib/tools.js" },
    "./persona": { "types": "./lib/types/persona.d.ts", "default": "./lib/persona.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "rules",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run tests/engine",
    "bench": "BENCH=1 vitest run tests/bench",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check:bundle": "node tests/client/check-bundle.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.14.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
