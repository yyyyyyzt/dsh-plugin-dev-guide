{
  "name": "wsgw-solution-review",
  "version": "0.1.0-dev.1",
  "description": "DSH plugin: AI pre-review of wsgw technical solutions (suggest-only, expert-confirmed, memory-backed).",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "solution-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyyyyyzt/dsh-plugin-dev-guide.git",
    "directory": "plugins/wsgw-solution-review"
  },
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./persona": {
      "types": "./lib/types/persona.d.ts",
      "default": "./lib/persona.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "rules",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
